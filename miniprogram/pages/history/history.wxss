.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
  overflow: hidden;
}

/* ===== 游戏类型切换（可左右滑动） ===== */
.game-toggle-scroll {
  white-space: nowrap;
  flex-shrink: 0;
  background: #fff;
  padding: 16rpx 0 0;
  box-sizing: border-box;
}
.game-toggle-scroll::-webkit-scrollbar { display: none; }
.game-toggle {
  display: inline-flex;
  padding: 0 30rpx;
  gap: 16rpx;
}
.toggle-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 28rpx;
  background: #f5f5f5;
  border-radius: 20rpx 20rpx 0 0;
  font-size: 26rpx;
  color: #94A3B8;
  font-weight: 600;
  transition: all 0.2s ease;
  border-bottom: 3rpx solid transparent;
}
.toggle-item.active {
  background: #fff;
  color: #07C160;
  border-bottom-color: #07C160;
}
.toggle-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
.tg-grid {
  display: grid;
  grid-template-columns: repeat(3, 8rpx);
  gap: 2rpx;
}
.tg-cell {
  width: 8rpx;
  height: 8rpx;
  background: #CBD5E1;
  border-radius: 2rpx;
}
.toggle-item.active .tg-cell {
  background: #07C160;
}
.tg-huarong .tg-cell {
  background: #CBD5E1;
}
.toggle-item.active .tg-huarong .tg-cell {
  background: #07C160;
}
.tg-empty {
  background: transparent !important;
}
/* ===== 积木迷阵Tab图标 ===== */
.mb-board-bg {
  width: 40rpx;
  height: 40rpx;
  background: #22C55E;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.toggle-item:not(.active) .mb-board-bg {
  background: #94A3B8;
}
/* 4行网格，每行flex */
.mb-grid-tab {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.mg-row {
  display: flex;
  gap: 2rpx;
  align-items: center;
}
.mg-cell {
  width: 6rpx;
  height: 6rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 1rpx;
}
.mg-block {
  border-radius: 2rpx;
  background: rgba(255,255,255,0.85);
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.08);
}
.mg-block-v-tab {
  width: 6rpx;
  height: 14rpx;
}
.mg-block-h-tab {
  width: 14rpx;
  height: 6rpx;
}
.mg-gap-tab {
  width: 6rpx;
  height: 6rpx;
  background: rgba(255,255,255,0.08);
  border: 1rpx dashed rgba(255,255,255,0.3);
  border-radius: 1rpx;
  box-sizing: border-box;
}
.mb-arrow-tab {
  position: absolute;
  bottom: 2rpx;
  font-size: 8rpx;
  color: rgba(255,255,255,0.5);
}

/* ===== 积木迷阵空状态图标 ===== */
.mb-empty-bg {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #22C55E;
  border-radius: 18rpx;
  width: 140rpx;
  height: 140rpx;
  position: relative;
}
.mb-grid-empty {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.mge-row {
  display: flex;
  gap: 4rpx;
  align-items: center;
}
.mge-cell {
  width: 22rpx;
  height: 22rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 4rpx;
}
.mge-block {
  background: rgba(255,255,255,0.9);
  border-radius: 5rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.08);
}
.mge-block-v {
  width: 22rpx;
  height: 48rpx;
}
.mge-block-h {
  width: 48rpx;
  height: 22rpx;
}
.mge-gap {
  width: 22rpx;
  height: 22rpx;
  background: rgba(255,255,255,0.08);
  border: 2rpx dashed rgba(255,255,255,0.3);
  border-radius: 4rpx;
  box-sizing: border-box;
}
.mb-arrow-empty {
  position: absolute;
  bottom: 4rpx;
  font-size: 14rpx;
  color: rgba(255,255,255,0.4);
}

/* 积木迷阵记录小星星 */
.mb-record-stars-sm {
  display: inline-flex;
  gap: 2rpx;
  margin-left: 6rpx;
}
.mb-star-sm {
  font-size: 20rpx;
  color: #E2E8F0;
  line-height: 1;
}
.mb-star-sm.on {
  color: #F59E0B;
}

.filter-wrapper {
  display: flex;
  align-items: center;
  padding: 20rpx 0 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}

.filter-all {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  background: #f5f5f5;
  border-radius: 28rpx;
  font-size: 30rpx;
  color: #666;
  margin-right: 20rpx;
  white-space: nowrap;
}

.filter-all.active {
  background: #E6F7ED;
  color: #07C160;
}

.filter-scroll {
  flex: 1;
  width: 0;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.filter-scroll-inner {
  display: inline-block;
  white-space: nowrap;
}

.filter-scroll .filter-item {
  display: inline-block;
  padding: 14rpx 28rpx;
  background: #f5f5f5;
  border-radius: 28rpx;
  font-size: 30rpx;
  color: #666;
  margin-right: 20rpx;
}

.filter-scroll .filter-item.active {
  background: #E6F7ED;
  color: #07C160;
}

/* ===== 难度筛选（可滑入滑出） ===== */
.size-filter-wrapper {
  overflow: hidden;
  transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  max-height: 140rpx;
  opacity: 1;
  flex-shrink: 0;
}
.size-filter-wrapper.size-filter-hide {
  max-height: 0;
  opacity: 0;
}

.size-filter-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding: 10rpx 30rpx 12rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.size-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 10rpx 0;
  background: #F8FAFC;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.size-grid-item:active {
  transform: scale(0.95);
}

.size-grid-item.active {
  background: rgba(7,193,96,0.06);
  border-color: #07C160;
  box-shadow: 0 4rpx 16rpx rgba(7,193,96,0.10);
}

.sgi-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 1rpx;
}

.size-grid-item.active .sgi-label {
  color: #07C160;
}



.swiper-wrap {
  flex: 1;
  width: 100%;
  overflow: hidden;
}

.scroll-wrap {
  height: 100%;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
}

.record-list {
  padding: 20rpx 30rpx;
  padding-bottom: 120rpx;
}

.record-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.record-body {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

.record-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
  flex: 1;
}

.record-mode {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.level-badge {
  font-size: 22rpx;
  color: #666;
  background: #f0f0f0;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.meta-sep {
  font-size: 22rpx;
  color: #ccc;
}

.accuracy-value {
  font-size: 24rpx;
  color: #888;
}

.record-time {
  font-size: 22rpx;
  color: #888;
}

.record-right {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 20rpx;
}

.challenge-result {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.status-badge {
  padding: 14rpx 32rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.status-badge.success {
  background: #E6F7ED;
  color: #07C160;
}

.status-badge.fail {
  background: #ffebee;
  color: #ef5350;
}

.time-badge.challenge-time {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.time-badge.challenge-time.success {
  background: #E6F7ED;
}

.time-badge.challenge-time.fail {
  background: #ffebee;
}

.time-badge.challenge-time.success .time-value {
  font-size: 24rpx;
  font-weight: 500;
  color: #07C160;
}

.time-badge.challenge-time.fail .time-value {
  font-size: 24rpx;
  font-weight: 500;
  color: #ef5350;
}

.time-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
}

.time-badge.success {
  background: #E6F7ED;
}

.time-badge.fail {
  background: #ffebee;
}

.time-value {
  font-size: 35rpx;
  font-weight: 700;
}

.time-badge.success .time-value {
  color: #07C160;
}

.time-badge.fail .time-value {
  color: #ef5350;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx 100rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  background: #E6F7ED;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.grid-icon {
  display: flex;
  flex-wrap: wrap;
  width: 60rpx;
  height: 60rpx;
  gap: 6rpx;
  justify-content: center;
  align-content: center;
}

.grid-cell {
  width: 14rpx;
  height: 14rpx;
  background: #07C160;
  border-radius: 3rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #64748B;
  font-weight: 500;
  margin-bottom: 28rpx;
}

.go-train {
  display: inline-flex;
  align-items: center;
  padding: 18rpx 44rpx;
  background: #07C160;
  border-radius: 44rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(7,193,96,0.25);
}

.go-train:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(7,193,96,0.15);
}
.go-train-wrap {
  padding: 10rpx 0 40rpx;
  display: flex;
  justify-content: center;
}

/* ===== 华容道独立区域 ===== */
.huarong-section {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.scroll-wrap {
  height: 100%;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
}
.huarong-section .scroll-wrap {
  flex: 1;
  height: 0;
}
.hr-empty-icon {
  font-size: 48rpx;
}
.huarong-section .record-meta {
  gap: 12rpx;
}
.huarong-section .level-badge {
  font-size: 26rpx;
  padding: 6rpx 18rpx;
}
.huarong-section .accuracy-value {
  font-size: 24rpx;
  color: #888;
}
.huarong-section .sd-star-text {
  font-size: 24rpx;
  color: #F59E0B;
  letter-spacing: 2rpx;
}
.huarong-section .sd-stat-row {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.huarong-section .sd-stat-item {
  font-size: 22rpx;
  color: #94A3B8;
  display: flex;
  align-items: center;
  white-space: nowrap;
}
.huarong-section .sd-stat-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #64748B;
}
.huarong-section .meta-sep {
  font-size: 26rpx;
}
.huarong-section .time-badge .time-value {
  font-size: 38rpx;
}
.huarong-board {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  padding: 16rpx !important;
  background: #E6F7ED !important;
  border-radius: 16rpx;
}
.hb-row {
  display: flex;
  gap: 3rpx;
}
.hb-cell {
  width: 22rpx;
  height: 22rpx;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12rpx;
  font-weight: 700;
  color: #fff;
  background: #07C160;
}
.hb-empty {
  background: transparent;
}

/* ===== 加载更多 ===== */
.load-more {
  text-align: center;
  padding: 30rpx 10rpx 60rpx;
  font-size: 26rpx;
  color: #bbb;
}

.load-more-btn {
  text-align: center;
  padding: 30rpx 10rpx 60rpx;
  font-size: 28rpx;
  color: #07C160;
}

/* 加载中 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 10rpx 60rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #ddd;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.loading-hint {
  text-align: center;
  padding: 40rpx 10rpx;
  font-size: 26rpx;
  color: #94A3B8;
}

/* ===== 数独 Tab 图标 ===== */
.sd-tab-grid {
  display: grid;
  grid-template-columns: repeat(3, 10rpx);
  gap: 2rpx;
}
.sd-tab-cell {
  width: 10rpx;
  height: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sd-tab-num {
  font-size: 7rpx;
  font-weight: 700;
  color: #3B82F6;
}

/* 数独记录 - 难度颜色 */
.level-badge.sd-easy { color: #059669; }
.level-badge.sd-medium { color: #D97706; }
.level-badge.sd-hard { color: #DC2626; }
.level-badge.sd-expert { color: #7C3AED; }

/* 数独空状态图标 */
.sd-empty-grid {
  display: grid;
  grid-template-columns: repeat(3, 16rpx);
  gap: 2rpx;
  padding: 6rpx;
  background: rgba(59,130,246,0.1);
  border-radius: 6rpx;
}
.sde-row {
  display: contents;
}
.sde-cell {
  width: 16rpx;
  height: 16rpx;
  background: #3B82F6;
  border-radius: 3rpx;
  opacity: 0.4;
}
