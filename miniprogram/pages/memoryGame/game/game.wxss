.page {
  min-height: 100vh;
  background: #F5F3FF;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 60rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 680rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}
.stats-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 20rpx 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.07), inset 0 -2rpx 0 rgba(0,0,0,0.03);
  border: 2rpx solid #EDE9FE;
}
.sb-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.sb-icon {
  width: 56rpx; height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.sb-icon-time {
  background: linear-gradient(135deg, #EDE9FE, #DDD6FE);
}
.sb-icon-errors {
  background: linear-gradient(135deg, #FEE2E2, #FECACA);
}
.sb-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.sb-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #1E293B;
  letter-spacing: -1rpx;
  white-space: nowrap;
}
.sb-sub {
  font-size: 18rpx;
  color: #94A3B8;
}
.sb-divider {
  width: 2rpx;
  height: 50rpx;
  background: linear-gradient(180deg, transparent, #E2E8F0, transparent);
  margin: 0 28rpx;
}
.settings-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}
.settings-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #7C3AED;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  background: linear-gradient(135deg, #EDE9FE, #DDD6FE);
}
.settings-btn:active { transform: scale(.92); }
.reset-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}
.reset-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #7C3AED;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  background: linear-gradient(135deg, #EDE9FE, #DDD6FE);
}
.reset-btn:active { transform: scale(.92); }

.game-rule {
  width: calc(100% - 48rpx);
  max-width: 680rpx;
  text-align: center;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #6D28D9;
  background: linear-gradient(135deg, rgba(139,92,246,0.08), rgba(167,139,250,0.06));
  border: 2rpx solid rgba(139,92,246,0.12);
  line-height: 1.6;
}

.board-wrap {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  width: 100%;
  padding: 0 16rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}
.board {
  display: flex;
  flex-wrap: wrap;
  background: #E2E8F0;
  border-radius: 16rpx;
  padding: 4rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}
.cell {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 2rpx solid #E2E8F0;
  border-radius: 8rpx;
  box-sizing: border-box;
  transition: all 0.15s ease;
  position: relative;
}
/* 有数字的格子紫色背景 */
.cell.has-num {
  background: linear-gradient(135deg, #8B5CF6, #A78BFA);
  box-shadow: 0 2rpx 8rpx rgba(139,92,246,0.25);
}
/* 空格子 */
.cell.empty {
  background: #F8FAFC;
  border-color: #E2E4E8;
}
.cell:active { transform: scale(0.92); }
.cell-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.15);
}



/* ===== 设置弹窗 ===== */
.help-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s ease;
}
.help-overlay.active {
  opacity: 1;
  pointer-events: auto;
}
.help-dialog {
  width: 560rpx;
  max-width: 85vw;
  background: #fff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.16);
}
.game-settings-dialog {
  padding-bottom: 28rpx;
}
.help-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1E293B;
  text-align: center;
  margin-bottom: 24rpx;
}
.settings-list {
  margin: 24rpx 0;
}
.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(139,92,246,0.08);
}
.settings-row:last-child { border-bottom: none; }
.settings-label-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.settings-icon {
  font-size: 32rpx;
}
.settings-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #5B21B6;
}
.help-close-btn {
  display: block;
  width: 100%;
  text-align: center;
  background: linear-gradient(135deg, #8B5CF6, #7C3AED);
  color: #FFF;
  font-size: 28rpx;
  font-weight: 700;
  padding: 22rpx 0;
  border-radius: 48rpx;
  cursor: pointer;
  box-shadow: 0 6rpx 20rpx rgba(124,58,237,0.3);
}
.help-close-btn:active { transform: scale(0.97); }

@media (min-width: 500px) {
  .sb-value {
    font-size: 28rpx;
  }
  .sb-icon {
    width: 44rpx;
    height: 44rpx;
    font-size: 22rpx;
  }
  .sb-divider {
    height: 36rpx;
    margin: 0 16rpx;
  }
  .settings-btn, .reset-btn {
    width: 44rpx;
    height: 44rpx;
  }
}
