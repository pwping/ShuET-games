.page {
  min-height: 100vh;
  background: linear-gradient(180deg,#F0FDF4 0%,#FFFFFF 100%);
  padding-bottom: 60rpx;
}

/* ===== Hero ===== */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 40rpx 56rpx;
}

.hero-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg,#07C160,#10D579);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.25);
}

.grid-icon-large {
  display: flex;
  flex-wrap: wrap;
  width: 48rpx;
  height: 48rpx;
  gap: 4rpx;
  justify-content: center;
  align-content: center;
}

.g-cell {
  width: 12rpx;
  height: 12rpx;
  background: #fff;
  border-radius: 2rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1E293B;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #64748B;
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* ===== Section ===== */
.section {
  padding: 0 32rpx 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #07C160;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 1rpx;
}

/* ===== Card ===== */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  border: 2rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.06), 0 1rpx 4rpx rgba(0,0,0,0.04);
}

.card-text {
  display: block;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.card-text:last-child {
  margin-bottom: 0;
}

/* ===== Benefit List ===== */
.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.06), 0 1rpx 4rpx rgba(0,0,0,0.04);
}

.benefit-item:active {
  transform: scale(0.96) translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.benefit-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #07C160;
  width: 64rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.benefit-content {
  flex: 1;
}

.benefit-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 6rpx;
}

.benefit-desc {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.5;
}

/* ===== Tips ===== */
.tip-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.tip-row:last-child {
  margin-bottom: 0;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.tip-text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.5;
  flex: 1;
}

/* ===== 参考等级表 ===== */
.ref-table {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

.table-row {
  display: grid;
  grid-template-columns: 30% 25% 25% 20%;
  min-height: 72rpx;
  border-bottom: 2rpx solid #EDE9E5;
  border-left: 2rpx solid #EDE9E5;
  border-right: 2rpx solid #EDE9E5;
  box-sizing: border-box;
}

.table-row:first-child {
  border-top: 2rpx solid #EDE9E5;
  border-radius: 20rpx 20rpx 0 0;
}

.table-row:last-child {
  border-bottom: 2rpx solid #EDE9E5;
  border-radius: 0 0 20rpx 20rpx;
}

.table-row.table-header {
  background: #F0FDF4;
}

.table-row:not(.table-header):nth-child(even) {
  background: #F8FAF9;
}

.table-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  color: #1E293B;
  text-align: center;
  line-height: 1.3;
  box-sizing: border-box;
  border-right: 2rpx solid #EDE9E5;
}

.table-cell:last-child {
  border-right: none;
}

.table-header .table-cell {
  font-size: 22rpx;
  font-weight: 700;
  color: #07C160;
}

.header-text-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.2;
}

.header-main {
  font-size: 24rpx;
  font-weight: 700;
  color: #07C160;
}

.header-sub {
  font-size: 18rpx;
  font-weight: 400;
  color: #6BC47E;
  margin-top: 4rpx;
}

.col-age {
  font-weight: 500;
}

.col-good {
  font-weight: 600;
  color: #07C160;
}

.col-poor {
  color: #94A3B8;
}

.ref-source {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #B0A9A3;
  text-align: center;
}

/* ===== 重要提示 ===== */
.tips-section {
  background: #F0FDF4;
  border: 2rpx solid rgba(7,193,96,0.12);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
}

.tip-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #07C160;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tip-head {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E293B;
}

.tip-desc {
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.5;
}

/* ===== Footer ===== */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 32rpx 48rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #94A3B8;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

.footer-copy {
  font-size: 22rpx;
  color: #CBD5E1;
}

/* ===== 联系开发者 ===== */
.contact-bar {
  display: flex;
  justify-content: center;
  padding: 40rpx 36rpx 60rpx;
}

.contact-text {
  font-size: 24rpx;
  color: #94A3B8;
  padding: 16rpx 36rpx;
  border-radius: 24rpx;
  background: rgba(148,163,184,0.08);
}
