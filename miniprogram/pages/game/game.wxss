.container {
  min-height: 100vh;
  background: #EEF0F4;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* 规则提示 */
.rule-hint {
  text-align: center;
  padding: 6rpx 30rpx 14rpx;
  font-size: 22rpx;
  color: #94A3B8;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* ===== 提示框（下一个数 + 计时器） ===== */
.hint-box {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 40rpx 36rpx 16rpx;
  padding: 24rpx 30rpx;
  background: #fff;
  border-radius: 28rpx;
  height: 130rpx;
  box-sizing: border-box;
  border: 2rpx solid #E5E7EB;
}

.hint-section, .timer-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
}

.timer-section.full {
  min-width: 0;
  width: 100%;
}

.hint-box.no-hint {
  justify-content: center;
}

.hint-label {
  font-size: 22rpx;
  color: #94A3B8;
  font-weight: 500;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.hint-value {
  font-size: 52rpx;
  font-weight: 800;
  color: #07C160;
  line-height: 1;
}

.timer-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1E1B4B;
  font-family: 'Courier New', Courier, monospace;
  line-height: 1;
  letter-spacing: 2rpx;
}

.timer-value.memory-timer {
  color: #07C160;
  font-size: 42rpx;
  font-weight: 600;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  letter-spacing: 1rpx;
}

.memory-timer-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.memory-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #07C160;
  line-height: 1;
}

.memory-text {
  font-size: 36rpx;
  font-weight: 500;
  color: #07C160;
  line-height: 1;
}

.hint-divider {
  width: 2rpx;
  height: 56rpx;
  background: #E2E8F0;
  margin: 0 36rpx;
}

/* ===== 棋盘容器 ===== */
.game-board-container {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 12rpx 36rpx 16rpx;
  position: relative;
}

.game-board {
  display: grid;
  gap: 14rpx;
  width: 100%;
  max-width: 700rpx;
  aspect-ratio: 1;
}

.game-board.board-disabled {
  pointer-events: none;
}

.game-board.memory-disabled {
  pointer-events: none;
}

/* ===== 棋盘中央开始按钮 ===== */
.start-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: #fff;
  font-weight: 700;
  z-index: 10;
  letter-spacing: 2rpx;
}

.start-btn:active {
  transform: translate(-50%, -50%) scale(0.92);
}

/* ===== 记忆模式跳过按钮 ===== */
.memory-skip-btn-outer {
  display: flex;
  justify-content: center;
  padding: 16rpx 36rpx 24rpx;
}

.memory-skip-btn {
  padding: 18rpx 48rpx;
  background: #07C160;
  border-radius: 44rpx;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
}

.memory-skip-btn.show {
  opacity: 1;
  pointer-events: auto;
}

.memory-skip-btn text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.memory-skip-btn:active {
  background: #059669;
  transform: scale(0.96);
}

/* ===== 棋盘格子 ===== */
.game-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1E1B4B;
  border: 4rpx solid rgba(255,255,255,0.6);
  position: relative;
}

.game-cell:active {
  transform: scale(0.94);
}

/* 正确闪烁 */
.game-cell.flash-correct {
  background: #07C160 !important;
  color: #fff !important;
}

/* 错误闪烁 */
.game-cell.flash-wrong {
  background: #EF4444 !important;
  color: #fff !important;
}

.game-cell.hidden {
  opacity: 0;
  visibility: hidden;
}

.game-cell.marked {
  background: #07C160 !important;
  color: #fff !important;
}

/* ===== 底部卡片 ===== */
.bottom-card {
  background: #fff;
  border-radius: 28rpx;
  margin: 0 24rpx 24rpx;
  border: 2rpx solid #E5E7EB;
  overflow: hidden;
}

/* ===== 进度条 ===== */
.progress-bar-container {
  padding: 24rpx 36rpx 8rpx;
}

.progress-bar-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.progress-bar {
  flex: 1;
  height: 10rpx;
  background: #E2E8F0;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #07C160;
  border-radius: 5rpx;
}

.refresh-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E6F7ED;
  border-radius: 50%;
}

.refresh-btn:active {
  background: #C8E9D6;
  transform: rotate(180deg);
}

.refresh-icon {
  font-size: 30rpx;
  color: #07C160;
  font-weight: 600;
}

/* ===== 工具栏 ===== */
.game-tools {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding: 12rpx 30rpx 24rpx;
  background: #fff;
}

.tool-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  opacity: 0.5;
  transition: opacity 0.2s;
}

.tool-item.active {
  opacity: 1;
}

.tool-item.disabled {
  opacity: 0.25;
  pointer-events: none;
}

.tool-switch {
  width: 76rpx;
  height: 42rpx;
  background: #CBD5E1;
  border-radius: 21rpx;
  position: relative;
}

.tool-item.active .tool-switch {
  background: #07C160;
}

.tool-slider {
  width: 34rpx;
  height: 34rpx;
  background: #fff;
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
}

.tool-slider.on {
  transform: translateX(34rpx);
}

.tool-label {
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
}

/* ===== 覆盖层 ===== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.start-stage {
  font-size: 48rpx;
  color: #fff;
  margin-bottom: 60rpx;
  font-weight: 600;
}

.btn-primary {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
}

.countdown-overlay {
  background: rgba(0,0,0,0.10);
}

.countdown-stage {
  font-size: 36rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 40rpx;
}

.countdown-number {
  font-size: 200rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 0 40rpx rgba(7,193,96,0.5);
}

/* ===== 参考按钮 ===== */
.ref-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E6F7ED;
  border-radius: 16rpx;
  transition: background 0.2s;
}

.ref-btn:active {
  background: #C8E9D6;
}

/* ===== 游戏设置按钮 ===== */
.settings-btn-game {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E6F7ED;
  border-radius: 16rpx;
  transition: background 0.2s;
}
.settings-btn-game:active {
  background: #C8E9D6;
}
.settings-icon-game {
  font-size: 32rpx;
  color: #07C160;
}

/* ===== 游戏设置弹窗 ===== */
.settings-overlay-game {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s ease;
}
.settings-overlay-game.active {
  opacity: 1;
  pointer-events: auto;
}
.settings-dialog-game {
  width: 540rpx;
  max-width: 85vw;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 28rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
}
.settings-title-game {
  display: block;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}
.settings-list-game {
  margin: 24rpx 0;
}
.settings-row-game {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(7,193,96,0.08);
}
.settings-row-game:last-child { border-bottom: none; }
.settings-label-wrap-game {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.settings-icon-game-label {
  font-size: 32rpx;
}
.settings-label-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
}
.settings-switch-game {
  flex-shrink: 0;
}
.settings-btn-close-game {
  display: block;
  width: 100%;
  text-align: center;
  background: #07C160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 22rpx 0;
  border-radius: 48rpx;
  cursor: pointer;
  box-shadow: 0 6rpx 20rpx rgba(7,193,96,0.3);
  transition: transform .15s;
}
.settings-btn-close-game:active {
  transform: scale(0.97);
}

.ref-icon {
  display: flex;
  flex-wrap: wrap;
  width: 32rpx;
  height: 32rpx;
  gap: 3rpx;
  justify-content: center;
  align-content: center;
}

.r-cell {
  width: 8rpx;
  height: 8rpx;
  background: #07C160;
  border-radius: 2rpx;
}

/* ===== 底部参考面板 - 遮罩 ===== */
.ref-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
}

.ref-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* ===== 底部参考面板 - 内容 ===== */
.ref-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: #FAF8F5;
  border-radius: 36rpx 36rpx 0 0;
  max-height: 75vh;
  width: 100vw;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  will-change: transform;
  transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
  visibility: hidden;
}

.ref-sheet.sheet-active {
  pointer-events: auto;
  visibility: visible;
}

.ref-sheet.dragging {
  transition: none;
}

/* ===== 拖拽条 ===== */
.sheet-handle-area {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 10rpx;
  flex-shrink: 0;
}

.sheet-handle {
  width: 60rpx;
  height: 6rpx;
  background: #D4CFC9;
  border-radius: 3rpx;
}

/* ===== 标题 ===== */
.sheet-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 8rpx 32rpx 20rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #1E1B4B;
}

.sheet-title-icon {
  display: flex;
  flex-wrap: wrap;
  width: 36rpx;
  height: 36rpx;
  gap: 4rpx;
  justify-content: center;
  align-content: center;
}

.st-cell {
  width: 9rpx;
  height: 9rpx;
  background: #07C160;
  border-radius: 2rpx;
}

/* ===== 可滚动内容区 ===== */
.sheet-scroll {
  flex: 1;
  overflow-y: scroll;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  padding: 0 0 50rpx;
  min-width: 0;
}

.scroll-inner {
  padding: 0 32rpx;
}

/* ===== 参考表格 ===== */
.ref-table {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

.table-row {
  display: grid;
  grid-template-columns: 30% 25% 25% 20%;
  min-height: 72rpx;
  border-bottom: 2rpx solid #EDE9E5;
  border-left: 2rpx solid #EDE9E5;
  border-right: 2rpx solid #EDE9E5;
  box-sizing: border-box;
}

.table-row:first-child {
  border-top: 2rpx solid #EDE9E5;
  border-radius: 20rpx 20rpx 0 0;
}

.table-row:last-child {
  border-bottom: 2rpx solid #EDE9E5;
  border-radius: 0 0 20rpx 20rpx;
}

.table-row.table-header {
  background: #F0FDF4;
}

.table-row:not(.table-header):nth-child(even) {
  background: #F8FAF9;
}

.table-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  color: #1E1B4B;
  text-align: center;
  line-height: 1.3;
  box-sizing: border-box;
  border-right: 2rpx solid #EDE9E5;
}

.table-cell:last-child {
  border-right: none;
}

.table-header .table-cell {
  font-size: 22rpx;
  font-weight: 700;
  color: #07C160;
}

.header-text-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.2;
}

.header-main {
  font-size: 24rpx;
  font-weight: 700;
  color: #07C160;
}

.header-sub {
  font-size: 18rpx;
  font-weight: 400;
  color: #07C160;
  margin-top: 4rpx;
}

.col-age {
  font-weight: 500;
}

.col-good {
  font-weight: 600;
  color: #07C160;
}

.col-poor {
  color: #94A3B8;
}

/* ===== 数据来源 ===== */
.ref-source {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #B0A9A3;
  text-align: center;
}

/* ===== 重要提示区块 ===== */
.tips-section {
  background: #FFFBEB;
  border: 2rpx solid #FDE68A;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 28rpx;
}

.tips-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #92400E;
}

.tips-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #F59E0B;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tip-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #FDE68A;
  color: #92400E;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tip-head {
  font-size: 26rpx;
  font-weight: 600;
  color: #92400E;
}

.tip-desc {
  font-size: 22rpx;
  color: #A16207;
  line-height: 1.5;
}

/* ===== iPad 大屏适配 —— 棋盘最大化，一屏显示 ===== */
@media (min-width: 500px) {
  .container {
    min-height: auto;
    height: 100vh;
  }
  .hint-box {
    margin: 12rpx 24rpx 6rpx;
    padding: 10rpx 20rpx;
    height: 68rpx;
  }
  .rule-hint {
    padding: 0 30rpx 2rpx;
    font-size: 18rpx;
  }
  .hint-value {
    font-size: 38rpx;
  }
  .timer-value {
    font-size: 34rpx;
  }
  .hint-divider {
    margin: 0 18rpx;
  }
  .game-board-container {
    padding: 4rpx 20rpx 4rpx;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .game-board {
    gap: 10rpx;
    width: 100%;
    max-width: 560rpx;
  }
  .game-cell {
    border-radius: 14rpx;
    font-size: 38rpx;
  }
  .bottom-card {
    margin: 0 24rpx 8rpx;
  }
  .progress-bar-container {
    padding: 8rpx 24rpx 4rpx;
  }
  .game-tools {
    padding: 4rpx 30rpx 8rpx;
  }
}
