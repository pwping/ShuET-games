<view class="page-container">
  <!-- 顶部信息栏 -->
  <view class="top-bar">
    <view class="tb-left" bindtap="onBack">
      <view class="tb-btn tb-back-btn">←</view>
    </view>
    <view class="tb-center">
      <text class="tb-title">{{size}}×{{size}}</text>
      <text class="tb-sub">华容道</text>
    </view>
    <view class="tb-right" bindtap="onReset">
      <view class="tb-btn tb-reset-btn">↻</view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-bar">
    <view class="sb-item sb-time">
      <view class="sb-icon sb-icon-time">⏱</view>
      <view class="sb-info">
        <text class="sb-value">{{timerStr}}</text>
        <text class="sb-label">用时</text>
      </view>
    </view>
    <view class="sb-divider"></view>
    <view class="sb-item sb-moves">
      <view class="sb-icon sb-icon-steps">👣</view>
      <view class="sb-info">
        <text class="sb-value">{{moves}}</text>
        <text class="sb-label">步数</text>
      </view>
    </view>
  </view>

  <!-- 棋盘容器 -->
  <view class="board-wrapper">
    <view class="board-frame">
      <view class="board" style="width:{{boardPx}}px;height:{{boardPx}}px;">
        <view class="tile tile-{{item.colorClass}}" wx:for="{{tiles}}" wx:key="num"
          style="left:{{item.col * tilePx + padding}}px;top:{{item.row * tilePx + padding}}px;width:{{tileInner}}px;height:{{tileInner}}px;"
          bindtap="onTileTap" data-row="{{item.row}}" data-col="{{item.col}}">
          <view class="tile-inner">
            <text class="tile-num">{{item.num}}</text>
            <text class="tile-en">{{item.english}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 胜利弹窗 -->
  <view class="win-overlay" wx:if="{{solved}}">
    <view class="win-card">
      <view class="win-header">
        <view class="win-stars">★ ★ ★</view>
        <text class="win-title">太棒了!</text>
        <text class="win-sub">你完成了挑战</text>
      </view>
      <view class="win-stats">
        <view class="ws-item">
          <text class="ws-val">{{timerStr}}</text>
          <text class="ws-lbl">用时</text>
        </view>
        <view class="ws-item">
          <text class="ws-val">{{moves}}步</text>
          <text class="ws-lbl">步数</text>
        </view>
      </view>
      <view class="win-actions">
        <button class="win-btn win-btn-primary" bindtap="onReset">再来一次</button>
        <button class="win-btn win-btn-secondary" bindtap="onBack">返回</button>
      </view>
    </view>
  </view>
</view>