/* ===== 马卡龙色系变量 ===== */
page {
  --macaron-pink: #FFD1DC;
  --macaron-pink-dark: #FFB6C1;
  --macaron-yellow: #FFFACD;
  --macaron-yellow-dark: #F0E68C;
  --macaron-green: #C1FFC1;
  --macaron-green-dark: #98FB98;
  --macaron-blue: #B0E0E6;
  --macaron-blue-dark: #ADD8E8;
  --macaron-purple: #E6E6FA;
  --macaron-purple-dark: #DDA0DD;
  --macaron-peach: #FFDAB9;
  --macaron-peach-dark: #FFBFA3;
  background: linear-gradient(180deg, #FFF9F0 0%, #FFF5F5 50%, #F0F8FF 100%);
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center;
  padding: 90rpx 0 60rpx;
}

/* ===== 统计卡片 ===== */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 680rpx;
  padding: 0 24rpx;
  margin: 0 auto 32rpx;
  box-sizing: border-box;
}
.stats-bar {
  display: flex; align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 48rpx;
  box-shadow:
    0 6rpx 20rpx rgba(0,0,0,0.07),
    inset 0 -2rpx 0 rgba(0,0,0,0.03);
  border: 2rpx solid #F0F0F0;
}
.sb-item {
  display: flex; align-items: center;
  gap: 20rpx;
}
.sb-icon {
  width: 64rpx; height: 64rpx;
  border-radius: 18rpx;
  display: flex; align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.sb-icon-time {
  background: linear-gradient(135deg, var(--macaron-yellow), var(--macaron-yellow-dark));
}
.sb-icon-steps {
  background: linear-gradient(135deg, var(--macaron-green), var(--macaron-green-dark));
}
.sb-info {
  display: flex; flex-direction: column;
  gap: 4rpx;
}
.sb-value {
  font-size: 42rpx; font-weight: 800;
  color: #333;
  letter-spacing: -1rpx;
  white-space: nowrap;
}
.sb-divider {
  width: 2rpx; height: 56rpx;
  background: linear-gradient(180deg, transparent, #E0E0E0, transparent);
  margin: 0 32rpx;
}
.settings-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  cursor: pointer;
}
.settings-btn {
  width: 64rpx; height: 64rpx;
  border-radius: 18rpx;
  display: flex; align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #4682B4;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  background: linear-gradient(135deg, #B0E0E6, #ADD8E8);
  transition: transform .15s ease;
}
.settings-btn:active { transform: scale(.92); }

/* 设置弹窗 */
.settings-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
  opacity: 0; pointer-events: none;
  transition: opacity 0.25s;
}
.settings-overlay.active {
  opacity: 1; pointer-events: auto;
}
.settings-dialog {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 28rpx;
  width: 540rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
}
.settings-title {
  display: block;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}
.settings-list { margin: 24rpx 0; }
.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(233,30,99,0.06);
}
.settings-row:last-child { border-bottom: none; }
.settings-label-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.settings-icon { font-size: 32rpx; }
.settings-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
}
.settings-close-btn {
  display: block;
  width: 100%;
  text-align: center;
  background: linear-gradient(135deg, #FFB6C1, #FF69B4);
  color: #fff;
  font-size: 28rpx; font-weight: 700;
  padding: 22rpx 0;
  border-radius: 48rpx;
  cursor: pointer;
  box-shadow: 0 6rpx 20rpx rgba(255,105,180,0.3);
  transition: transform .15s;
}
.settings-close-btn:active { transform: scale(.97); }

.reset-wrap {
  display: flex;
  margin-left: 10rpx;
  align-items: center;
}
.reset-btn {
  width: 64rpx; height: 64rpx;
  border-radius: 18rpx;
  display: flex; align-items: center;
  justify-content: center;
  font-size: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  background: linear-gradient(135deg, var(--macaron-blue), var(--macaron-blue-dark));
  color: #4682B4;
  transition: transform .15s ease;
}
.reset-btn:active { transform: scale(.92); }
.reset-btn.disabled { opacity: .3; }

/* ===== 棋盘容器 ===== */
.board-frame {
  position: relative;
  box-sizing: border-box;
  width: calc(100% - 24rpx);
  padding: 12rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow:
    0 8rpx 32rpx rgba(0,0,0,0.08),
    inset 0 2rpx 0 rgba(255,255,255,0.8),
    inset 0 -2rpx 0 rgba(0,0,0,0.04);
  border: 3rpx solid #E8E8E8;
}

.board {
  position: relative;
  background: var(--board-bg);
  border-radius: 18rpx;
  overflow: hidden;
}

/* ===== 棋盘中央开始按钮 ===== */
.board-disabled-layer {
  position: absolute;
  inset: 0;
  z-index: 9;
}
.start-btn-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #07C160;
  box-shadow: 0 8rpx 32rpx rgba(7,193,96,.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: transform .18s ease;
}
.start-btn-overlay:active {
  transform: translate(-50%, -50%) scale(0.92);
}
.start-btn-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 3rpx;
}

/* ===== 底部卡片（宽度与棋盘框对齐）===== */
.bottom-card {
  width: calc(100% - 24rpx);
  background: #fff;
  border-radius: 28rpx;
  margin: 28rpx 0 0;
  border: 2rpx solid #E5E7EB;
  overflow: hidden;
}
.progress-bar-container {
  padding: 24rpx 36rpx;
}
.progress-bar-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.progress-bar {
  flex: 1;
  height: 10rpx;
  background: #E2E8F0;
  border-radius: 5rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #07C160;
  border-radius: 5rpx;
  transition: width .3s ease;
}
.progress-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #E91E63;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ===== 提示按钮 ===== */
.hint-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: #fff;
  border: 2rpx solid #E5E7EB;
  border-radius: 36rpx;
  position: relative;
  flex-shrink: 0;
  transition: transform .15s, box-shadow .15s;
}
.hint-chip:active { transform: scale(.94); }
.hint-chip-icon { font-size: 24rpx; line-height: 1; }
.hint-chip-lbl {
  font-size: 24rpx; font-weight: 600; color: #6A5ACD;
  letter-spacing: 1rpx;
}

/* ===== 提示次数角标 ===== */
.hint-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #E91E63;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 6rpx rgba(233,30,99,0.3);
}

/* ===== AD 胶囊标识 ===== */
.ad-badge {
  position: absolute;
  top: -4rpx;
  right: -2rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #fff;
  border: 1rpx solid #D4D4D8;
  border-radius: 20rpx;
  padding: 2rpx 8rpx 2rpx 6rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.08);
}
.ad-badge-play {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 6rpx 0 6rpx 10rpx;
  border-color: transparent transparent transparent #71717A;
}
.ad-badge-text {
  font-size: 16rpx;
  font-weight: 600;
  color: #71717A;
  line-height: 1;
}

/* ===== 马卡龙方块（核心！）===== */
.tile {
  position: absolute;
  border-radius: 14rpx;
  cursor: pointer;
  transition: left 0.2s ease, top 0.2s ease;
  display: flex; align-items: center;
  justify-content: center;
}

.tile-inner {
  width: 100%; height: 100%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  border-radius: 12rpx;
  border: 2rpx solid rgba(255,255,255,.6);
}

.tile-num {
  font-weight: 900;
  line-height: 1.1;
}

/* 马卡龙色系 - 6色循环 */
.tile-pink {
  background: linear-gradient(145deg, var(--macaron-pink), var(--macaron-pink-dark));
}
.tile-pink .tile-num { color: #8B4557; }

.tile-yellow {
  background: linear-gradient(145deg, var(--macaron-yellow), var(--macaron-yellow-dark));
}
.tile-yellow .tile-num { color: #8B8000; }

.tile-green {
  background: linear-gradient(145deg, var(--macaron-green), var(--macaron-green-dark));
}
.tile-green .tile-num { color: #2E8B57; }

.tile-blue {
  background: linear-gradient(145deg, var(--macaron-blue), var(--macaron-blue-dark));
}
.tile-blue .tile-num { color: #4682B4; }

.tile-purple {
  background: linear-gradient(145deg, var(--macaron-purple), var(--macaron-purple-dark));
}
.tile-purple .tile-num { color: #6A5ACD; }

.tile-peach {
  background: linear-gradient(145deg, var(--macaron-peach), var(--macaron-peach-dark));
}
.tile-peach .tile-num { color: #CD853F; }

/* ===== iPad 大屏适配 ===== */
@media (min-width: 500px) {
  .page-container {
    height: 100vh;
    min-height: auto;
    padding: 16rpx 0 8rpx;
  }
  .stats-row {
    margin-bottom: 6rpx;
  }
  .stats-bar {
    padding: 10rpx 24rpx;
  }
  .sb-value {
    font-size: 28rpx;
  }
  .sb-icon {
    width: 40rpx;
    height: 40rpx;
    font-size: 22rpx;
  }
  .sb-divider {
    height: 32rpx;
    margin: 0 12rpx;
  }
  .settings-wrap,
  .reset-wrap {
    margin-right: 4rpx;
  }
  .settings-btn,
  .reset-btn {
    width: 48rpx;
    height: 48rpx;
    font-size: 26rpx;
  }
  .board-frame {
    padding: 6rpx;
  }
  .bottom-card {
    margin-top: 8rpx;
  }
  .progress-bar-container {
    padding: 6rpx 24rpx;
  }
  .progress-label {
    font-size: 20rpx;
  }
  .hint-chip {
    padding: 6rpx 14rpx;
  }
  .hint-chip-icon {
    font-size: 20rpx;
  }
  .hint-chip-lbl {
    font-size: 20rpx;
  }
  .hint-badge {
    min-width: 26rpx;
    height: 26rpx;
    font-size: 16rpx;
  }
}