page {
  --macaron-pink: #FFD1DC;
  --macaron-yellow: #FFFACD;
  --macaron-green: #C1FFC1;
}

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0F5 0%, #F0F8FF 50%, #FFF9F0 100%);
  display: flex; align-items: center;
  justify-content: center;
  padding: 40rpx;
}

/* ===== 结果卡片 ===== */
.result-card {
  width: 100%; max-width: 620rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 56rpx 44rpx 48rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow:
    0 20rpx 60rpx rgba(0,0,0,0.1),
    inset 0 1rpx 0 rgba(255,255,255,0.9);
  border: 3rpx solid rgba(255,209,220,0.3);
  animation: result-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes result-pop {
  0% { transform: scale(0.85) translateY(40rpx); opacity: 0; }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}

/* 装饰圆圈 */
.rc-decoration {
  position: absolute; top: -30rpx; left: -30rpx;
  right: -30rpx; height: 120rpx;
  pointer-events: none;
}
.deco-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}
.dc-1 {
  width: 80rpx; height: 80rpx;
  background: var(--macaron-pink);
  top: 10rpx; left: 40rpx;
}
.dc-2 {
  width: 60rpx; height: 60rpx;
  background: var(--macaron-yellow);
  top: 30rpx; right: 60rpx;
}
.dc-3 {
  width: 50rpx; height: 50rpx;
  background: var(--macaron-green);
  top: 20rpx; right: 140rpx;
}

/* 成功图标 */
.rc-icon-wrap {
  width: 120rpx; height: 120rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(145deg, var(--macaron-pink), #FFB6C1);
  border-radius: 50%;
  display: flex; align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 24rpx rgba(255,182,193,0.4),
    inset 0 2rpx 4rpx rgba(255,255,255,0.4);
  animation: icon-bounce 0.6s ease 0.2s both;
}
@keyframes icon-bounce {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}
.rc-icon { font-size: 56rpx; }

/* 标题 */
.rc-title {
  font-size: 44rpx; font-weight: 900;
  color: #333; margin-bottom: 8rpx;
  letter-spacing: -1rpx;
}
.rc-mode {
  font-size: 24rpx; color: #E91E63;
  font-weight: 600; margin-bottom: 36rpx;
}

/* 统计数据 */
.rc-stats {
  display: flex; align-items: center;
  justify-content: center; gap: 48rpx;
  margin-bottom: 32rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #FFF9F0, #FFF5F5);
  border-radius: 24rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.04);
}
.rs-item {
  display: flex; align-items: center;
  gap: 16rpx;
}
.rs-icon {
  width: 56rpx; height: 56rpx;
  border-radius: 16rpx;
  display: flex; align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
.rs-icon-time {
  background: linear-gradient(145deg, var(--macaron-yellow), #F0E68C);
}
.rs-icon-steps {
  background: linear-gradient(145deg, var(--macaron-green), #98FB98);
}
.rs-data {
  display: flex; flex-direction: column;
  gap: 2rpx; text-align: left;
}
.rs-value {
  font-size: 36rpx; font-weight: 900;
  color: #333; letter-spacing: -1rpx;
}
.rs-label { font-size: 20rpx; color: #AAA; font-weight: 500; }

.rs-divider {
  width: 2rpx; height: 52rpx;
  background: linear-gradient(180deg, transparent, #E0E0E0, transparent);
}

/* 星级评价 */
.rc-stars {
  margin-bottom: 36rpx;
}
.star {
  font-size: 44rpx;
  color: #E0E0E0;
  margin: 0 6rpx;
  transition: all .3s ease;
  text-shadow: none;
}
.star.active {
  color: #FFD700;
  text-shadow: 0 2rpx 8rpx rgba(255,215,0,0.4);
  animation: star-pop 0.4s ease both;
}
@keyframes star-pop {
  0% { transform: scale(0) rotate(-180deg); }
  100% { transform: scale(1) rotate(0); }
}

/* 操作按钮 */
.rc-actions {
  display: flex; gap: 20rpx;
}
.rca-btn {
  flex: 1; height: 92rpx;
  border-radius: 46rpx;
  font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0; line-height: 1;
  border: none;
  transition: transform .18s ease,
              box-shadow .18s ease;
}
.rca-btn::after { border: none; }
.rca-btn:active { transform: scale(.95); }

.btn-icon { font-size: 28rpx; }

.rca-btn-primary {
  background: linear-gradient(135deg, var(--macaron-pink), #FFB6C1);
  color: #8B4557;
  box-shadow: 0 6rpx 20rpx rgba(255,182,193,0.35);
}
.rca-btn-secondary {
  background: #F5F5F5;
  color: #666;
}