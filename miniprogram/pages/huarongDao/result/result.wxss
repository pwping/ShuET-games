page {
  --macaron-pink: #FFD1DC;
  --macaron-pink-dark: #FFB6C1;
  --macaron-yellow: #FFFACD;
  --macaron-yellow-dark: #F0E68C;
  --macaron-green: #C1FFC1;
  --macaron-green-dark: #98FB98;
}

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFF0F5 0%, #F0F8FF 50%, #FFF9F0 100%);
  position: relative;
  overflow: hidden;
}

/* ===== 装饰背景圆 ===== */
.deco-circle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.dc-big {
  top: -120rpx;
  right: -80rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(255,209,220,0.15) 0%, transparent 70%);
}
.dc-small {
  bottom: 200rpx;
  left: -180rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(176,224,230,0.12) 0%, transparent 70%);
}

/* ===== 主内容区 ===== */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 36rpx 20rpx;
}

/* ===== 成功图标 ===== */
.icon-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--macaron-pink), var(--macaron-pink-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255,182,193,0.35);
  margin-bottom: 28rpx;
  animation: icon-breathe 3s ease-in-out infinite;
}
@keyframes icon-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}
.icon-emoji {
  font-size: 72rpx;
  z-index: 1;
}
.icon-ring {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,182,193,0.35);
  animation: ring-pulse 2s ease-in-out infinite;
}
@keyframes ring-pulse {
  0%, 100% { transform: scale(1); opacity: 0.4; }
  50% { transform: scale(1.15); opacity: 0.1; }
}

/* ===== 标题 ===== */
.result-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #E91E63;
  margin-bottom: 12rpx;
  letter-spacing: -1rpx;
}
.mode-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 28rpx 8rpx 28rpx;
  background: rgba(255,182,193,0.15);
  color: #E91E63;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid rgba(255,182,193,0.2);
  margin-bottom: 28rpx;
}
.mb-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #E91E63;
}
.mb-size {
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, #E91E63, #FF6B9D);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  letter-spacing: -1rpx;
  box-shadow: 0 4rpx 12rpx rgba(233,30,99,0.3);
}

/* ===== 幽默语录 ===== */
.result-quote {
  font-size: 22rpx;
  color: #E91E63;
  text-align: center;
  line-height: 1.4;
  margin-bottom: 28rpx;
  padding: 12rpx 20rpx;
  background: rgba(233,30,99,0.04);
  border-radius: 20rpx;
  border: 2rpx solid rgba(233,30,99,0.08);
}

/* ===== 星级评价 ===== */
.stars-row {
  margin-bottom: 36rpx;
  display: flex;
  gap: 8rpx;
}
.star {
  font-size: 44rpx;
  color: #E0E0E0;
  transition: all .3s ease;
}
.star.active {
  color: #FFD700;
  text-shadow: 0 2rpx 8rpx rgba(255,215,0,0.4);
  animation: star-pop 0.4s ease both;
}
@keyframes star-pop {
  0% { transform: scale(0) rotate(-180deg); }
  100% { transform: scale(1) rotate(0); }
}

/* ===== 统计卡片 ===== */
.stats-row {
  display: flex;
  gap: 24rpx;
  width: 100%;
  margin-bottom: 28rpx;
}
.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border: 2rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.06), 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.stat-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}
.siw-time {
  background: linear-gradient(145deg, #FFC1CC, #FFB6C1);
  box-shadow: 0 4rpx 12rpx rgba(255,182,193,0.35);
}
.siw-steps {
  background: linear-gradient(145deg, #FFB6C1, #FF69B4);
  box-shadow: 0 4rpx 12rpx rgba(255,105,180,0.35);
}
.stat-icon {
  font-size: 30rpx;
}
.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #E91E63;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 22rpx;
  color: #E91E63;
  font-weight: 500;
}

/* ===== 操作按钮 ===== */
.bottom-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 12rpx;
}
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: 1;
  padding: 24rpx 0;
  background: linear-gradient(135deg, var(--macaron-pink), var(--macaron-pink-dark));
  color: #8B4557;
  border-radius: 48rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 28rpx rgba(255,182,193,0.35);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.btn-primary.btn-hover {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(255,182,193,0.2);
}
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 24rpx 0;
  margin: 0;
  background: #fff;
  color: #E91E63;
  border-radius: 48rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid rgba(233,30,99,0.2);
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-secondary::after { display: none; border: none; }
.btn-secondary.btn-hover-light {
  background: rgba(233,30,99,0.04);
  transform: scale(0.97);
}
.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  padding: 24rpx 0;
  margin: 0;
  background: #fff;
  color: #E91E63;
  border-radius: 48rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid rgba(233,30,99,0.2);
  transition: transform 0.15s ease, background 0.15s ease;
  line-height: 1.4;
  overflow: visible;
}
.btn-share::after { display: none; border: none; }
.share-hover {
  background: rgba(233,30,99,0.04);
  transform: scale(0.97);
}
.share-text { line-height: 1; }
