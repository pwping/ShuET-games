<view class="page-container">
  <!-- ===== 装饰背景圆 ===== -->
  <view class="deco-circle dc-big"></view>
  <view class="deco-circle dc-small"></view>

  <!-- ===== 主内容区 ===== -->
  <view class="main-content">
    <!-- 成功图标 -->
    <view class="icon-wrap">
      <text class="icon-emoji">🎉</text>
      <view class="icon-ring"></view>
    </view>

    <!-- 等级标题 -->
    <text class="result-title">{{gradeName}}</text>

    <!-- 星级评价（动态） -->
    <view class="stars-row">
      <text class="star {{starCount >= 1 ? 'active' : ''}}">★</text>
      <text class="star {{starCount >= 2 ? 'active' : ''}}">★</text>
      <text class="star {{starCount >= 3 ? 'active' : ''}}">★</text>
      <text class="star {{starCount >= 4 ? 'active' : ''}}">★</text>
      <text class="star {{starCount >= 5 ? 'active' : ''}}">★</text>
    </view>

    <view class="mode-badge">
      <text class="mb-name">数字华容道</text>
      <text class="mb-size">{{size}}×{{size}}</text>
    </view>

    <!-- 幽默语录 -->
    <text class="result-quote">{{quote}}</text>

    <!-- 统计卡片 -->
    <view class="stats-row">
      <view class="stat-card stat-card-time">
        <view class="stat-icon-wrap siw-time">
          <text class="stat-icon">⏱</text>
        </view>
        <text class="stat-value">{{timeStr}}</text>
        <text class="stat-label">用时</text>
      </view>
      <view class="stat-card stat-card-moves">
        <view class="stat-icon-wrap siw-steps">
          <text class="stat-icon">👣</text>
        </view>
        <text class="stat-value">{{moves}} 步</text>
        <text class="stat-label">步数</text>
      </view>
    </view>

    <!-- ===== 操作按钮 ===== -->
    <view class="bottom-actions">
      <view class="btn-primary" bindtap="onRetry" hover-class="btn-hover">
        <text>↻ 再来一次</text>
      </view>
      <view class="btn-secondary" bindtap="onChangeLevel" hover-class="btn-hover-light">
        <text>选难度</text>
      </view>
      <button class="btn-share" open-type="share" hover-class="share-hover">
        <view class="share-icon-wechat"></view>
        <text class="share-text">分享</text>
      </button>
    </view>

    <!-- ===== 贴片广告 ===== -->
    <view class="ad-wrap">
      <ad-custom unit-id="adunit-2bb753c35ab3d982"></ad-custom>
    </view>
  </view>
</view>