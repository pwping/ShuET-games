<view class="page-container">
  <!-- ===== 模式标题 Badge ===== -->
  <view class="mode-title-wrap">
    <view class="mode-title-badge">
      <view class="badge-dot"></view>
      数字华容道
    </view>
  </view>

  <!-- ===== 上方难度卡片（基础 → 极限）===== -->
  <view class="level-grid">
    <view class="level-card" wx:for="{{levelsTop}}" wx:key="key" bindtap="onLevelTap" data-size="{{item.size}}">
      <view class="card-row">
        <view class="card-block" style="background: {{item.color}};">
          <text class="card-size" style="color: {{item.txtColor}};">{{item.size}}×{{item.size}}</text>
        </view>
        <view class="card-info">
          <text class="card-name">{{item.desc}}</text>
          <text class="card-stars">{{item.stars}}</text>
          <text class="card-desc">{{item.subDesc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 贴片广告 ===== -->
  <view class="ad-wrap">
    <ad-custom unit-id="adunit-2bb753c35ab3d982"></ad-custom>
  </view>

  <!-- ===== 下方难度卡片（疯狂 → 宗师）===== -->
  <view class="level-grid">
    <view class="level-card" wx:for="{{levelsBottom}}" wx:key="key" bindtap="onLevelTap" data-size="{{item.size}}">
      <view class="card-row">
        <view class="card-block" style="background: {{item.color}};">
          <text class="card-size" style="color: {{item.txtColor}};">{{item.size}}×{{item.size}}</text>
        </view>
        <view class="card-info">
          <text class="card-name">{{item.desc}}</text>
          <text class="card-stars">{{item.stars}}</text>
          <text class="card-desc">{{item.subDesc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-safe"></view>
</view>
