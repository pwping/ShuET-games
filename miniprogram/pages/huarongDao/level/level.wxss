page {
  --macaron-pink: #FFD1DC;
  --macaron-yellow: #FFFACD;
  --macaron-green: #C1FFC1;
  --macaron-blue: #B0E0E6;
  --macaron-purple: #E6E6FA;
  --macaron-peach: #FFDAB9;
}

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F0 0%, #F0F8FF 50%, #FAFAFA 100%);
}

/* ===== Hero ===== */
.hero {
  position: relative;
  padding: 48rpx 32rpx 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}
.hero-bg {
  position: absolute;
  top: -60rpx; left: -100rpx; right: -100rpx;
  height: 340rpx;
  background: linear-gradient(180deg, rgba(176,224,230,0.4) 0%, rgba(255,218,185,0.3) 100%);
  border-radius: 0 0 80rpx 80rpx;
  z-index: 0;
}
.hero-content { position: relative; z-index: 1; }

.hero-badge {
  display: inline-flex; align-items: center; gap: 10rpx;
  font-size: 22rpx; font-weight: 600; color: #00838F;
  background: rgba(176,224,230,0.5);
  padding: 10rpx 28rpx; border-radius: 30rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid rgba(0,131,143,0.12);
}
.badge-emoji { font-size: 26rpx; }

.hero-title {
  font-size: 44rpx; font-weight: 900;
  color: #333; letter-spacing: -2rpx;
  margin-bottom: 8rpx;
}
.hero-desc {
  font-size: 24rpx; color: #888;
}

/* ===== 难度选择区域 ===== */
.level-section { padding: 0 32rpx 60rpx; }
.section-header {
  display: flex; align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx; padding: 0 4rpx;
}
.section-title {
  font-size: 32rpx; font-weight: 800;
  color: #333; letter-spacing: -1rpx;
}
.section-sub { font-size: 22rpx; color: #AAA; }

.level-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

/* 难度卡片 - 马卡龙色系 */
.level-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx 20rpx;
  display: flex; flex-direction: column;
  align-items: center; gap: 6rpx;
  box-shadow:
    0 4rpx 16rpx rgba(0,0,0,0.06),
    inset 0 1rpx 0 rgba(255,255,255,0.8);
  border: 2rpx solid rgba(0,0,0,0.04);
  transition: transform .18s ease,
              box-shadow .18s ease;
}
.level-card:active {
  transform: scale(.93) translateY(4rpx);
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

/* 各难度颜色 */
.lc-pink {
  border-top: 4rpx solid var(--macaron-pink);
}
.lc-pink .level-name { color: #E91E63; }
.lc-pink .level-stars { color: #F48FB1; }

.lc-yellow {
  border-top: 4rpx solid var(--macaron-yellow);
}
.lc-yellow .level-name { color: #F9A825; }
.lc-yellow .level-stars { color: #FFE082; }

.lc-green {
  border-top: 4rpx solid var(--macaron-green);
}
.lc-green .level-name { color: #43A047; }
.lc-green .level-stars { color: #A5D6A7; }

.lc-blue {
  border-top: 4rpx solid var(--macaron-blue);
}
.lc-blue .level-name { color: #0277BD; }
.lc-blue .level-stars { color: #81D4FA; }

.lc-purple {
  border-top: 4rpx solid var(--macaron-purple);
}
.lc-purple .level-name { color: #7B1FA2; }
.lc-purple .level-stars { color: #CE93D8; }

.lc-peach {
  border-top: 4rpx solid var(--macaron-peach);
}
.lc-peach .level-name { color: #EF6C00; }
.lc-peach .level-stars { color: #FFCC80; }

.lc-pink-dark {
  border-top: 4rpx solid #FFB6C1;
}
.lc-pink-dark .level-name { color: #C2185B; }
.lc-pink-dark .level-stars { color: #F06292; }

.lc-yellow-dark {
  border-top: 4rpx solid #F0E68C;
}
.lc-yellow-dark .level-name { color: #F57F17; }
.lc-yellow-dark .level-stars { color: #FFD54F; }

/* 卡片内容 */
.level-size {
  font-size: 32rpx; font-weight: 900;
  color: #333; letter-spacing: -1rpx;
}
.level-name {
  font-size: 20rpx; font-weight: 600;
}
.level-stars {
  font-size: 18rpx;
  margin-top: 4rpx;
}