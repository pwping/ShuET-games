/* 马卡龙色系 */
page {
  --mc-pink: #FFD1DC;
  --mc-yellow: #FFFACD;
  --mc-green: #C1FFC1;
  --mc-blue: #B0E0E6;
  --mc-purple: #E6E6FA;
  --mc-peach: #FFDAB9;
}

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F0 0%, #FFF5F5 50%, #F0F8FF 100%);
}

/* ===== 模式标题 Badge ===== */
.mode-title-wrap {
  padding: 72rpx 32rpx;
  display: flex;
  justify-content: center;
}
.mode-title-badge {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #8B4557;
  background: rgba(255, 209, 220, 0.35);
  padding: 12rpx 48rpx;
  border-radius: 44rpx;
  border: 2rpx solid rgba(255, 182, 193, 0.2);
}
.badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FFB6C1;
  animation: pulse-dot 2s ease-in-out infinite;
}
@keyframes pulse-dot {
  0%,100%{opacity:1;transform:scale(1)}
  50%{opacity:.3;transform:scale(.7)}
}

/* ===== 难度卡片网格 ===== */
.level-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 32rpx 40rpx;
}

.level-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 24rpx;
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border: 2rpx solid #F0F0F0;
  box-shadow:
    0 6rpx 24rpx rgba(0,0,0,0.06),
    0 1rpx 4rpx rgba(0,0,0,0.04);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  position: relative;
}

.level-card:active {
  transform: scale(0.96) translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.card-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

/* ===== 马卡龙色卡片方块 ===== */
.card-block {
  width: 110rpx;
  height: 110rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  box-shadow:
    inset 0 2rpx 4rpx rgba(255,255,255,0.5),
    inset 0 -3rpx 6rpx rgba(0,0,0,0.06);
}

.card-size {
  font-size: 36rpx;
  font-weight: 900;
  color: #fff;
  line-height: 1;
  letter-spacing: -0.5rpx;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.1);
}

/* ===== 右侧信息 ===== */
.card-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4A4A;
  margin-bottom: 2rpx;
  display: block;
}
.card-stars {
  font-size: 20rpx;
  color: #FFD700;
  letter-spacing: 2rpx;
  line-height: 1.2;
  text-shadow: 0 1rpx 2rpx rgba(255,215,0,0.2);
}
.card-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
  margin-top: 6rpx;
  display: block;
}

.bottom-safe {
  height: 40rpx;
}
