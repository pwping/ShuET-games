<view class="page-container {{animIn ? 'slide-in' : ''}}">
  <!-- ===== 模式标题 Badge ===== -->
  <view class="mode-title-wrap">
    <view class="mode-title-badge">
      <view class="badge-dot"></view>
      {{modeName}}
    </view>
  </view>

  <!-- ===== 难度卡片（前半 3x3 → 8x8） ===== -->
  <view class="level-grid {{mode === 'alphabet' ? 'single-col' : ''}}">
    <view class="level-card" wx:for="{{levels}}" wx:for-index="idx" wx:key="key" wx:if="{{mode === 'alphabet' || idx < 6}}" bindtap="onLevelTap" data-index="{{idx}}">
      <view class="card-row">
        <view class="card-block" style="background: {{item.color}};">
          <text class="card-size">{{item.size}}×{{item.size}}</text>
        </view>
        <view class="card-info">
          <text class="card-name">{{item.name}}</text>
          <text class="card-desc">{{item.desc}}</text>
        </view>
      </view>
      <text wx:if="{{item.size === 5 && (mode === 'classic' || mode === 'challenge')}}" class="card-hint">✈️ 飞行员平均8-10秒</text>
    </view>
  </view>

  <view class="ad-wrap-level">
    <ad-custom unit-id="adunit-2bb753c35ab3d982" bindload="adLoad" binderror="adError" bindclose="adClose"></ad-custom>
  </view>

  <!-- ===== 难度卡片（后半 9x9 → 10x10） ===== -->
  <view class="level-grid {{mode === 'alphabet' ? 'single-col' : ''}}" wx:if="{{mode !== 'alphabet'}}">
    <view class="level-card" wx:for="{{levels}}" wx:for-index="idx" wx:key="key" wx:if="{{idx >= 6}}" bindtap="onLevelTap" data-index="{{idx}}">
      <view class="shult-trophy {{item.locked && (!vipRemaining[item.key] || vipRemaining[item.key] <= 0) ? 'show' : ''}}">V</view>
      <view class="shult-count-badge {{item.locked && vipRemaining[item.key] > 0 ? 'show' : ''}}">
        <text class="shcb-text">{{vipRemaining[item.key]}}</text>
      </view>
      <view class="card-row">
        <view class="card-block" style="background: {{item.color}};">
          <text class="card-size">{{item.size}}×{{item.size}}</text>
        </view>
        <view class="card-info">
          <text class="card-name">{{item.name}}</text>
          <text class="card-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-safe"></view>

  <!-- ===== VIP 解锁弹窗 ===== -->
  <view class="vip-overlay {{showVipModal ? 'active' : ''}}" catchtouchmove="preventMove">
    <view class="vip-dialog">
      <view class="vip-close" bindtap="onVipModalClose">✕</view>
      <view class="vip-header">
        <view class="vip-crown-wrap">
          <view class="vip-crown-icon">🏆</view>
        </view>
        <text class="vip-title">解锁高级难度</text>
        <text class="vip-sub">{{vipModalSize}}×{{vipModalSize}}等你来挑战</text>
      </view>
      <view class="vip-body">
        <view class="vip-desc">
          <text class="vip-desc-line">可以通过分享或者观看广告</text>
          <text class="vip-desc-line">立即获得<text class="vip-highlight">5</text>次免费体验机会</text>
          <text class="vip-desc-line">次数用完后可再次获取</text>
        </view>
      </view>
      <view class="vip-actions">
        <button class="vip-btn vip-btn-share" open-type="share" hover-class="vip-btn-hover">
          <view class="vip-btn-icon vip-share-icon"></view>
          <text class="vip-btn-lbl">分享给好友</text>
        </button>
        <view class="vip-btn vip-btn-ad" bindtap="onVipAdTap" hover-class="vip-btn-hover">
          <view class="vip-btn-icon vip-ad-icon"></view>
          <text class="vip-btn-lbl">观看广告</text>
        </view>
      </view>
    </view>
  </view>
<time-up-modal visible="{{_timeUpModalVisible}}" />
</view>
