<view class="page-container">
  <!-- ===== 顶部标题区 ===== -->
  <view class="page-header">
    <view class="header-icon">
      <view class="header-grid">
        <view class="h-cell"></view>
        <view class="h-cell"></view>
        <view class="h-cell"></view>
        <view class="h-cell"></view>
        <view class="h-cell"></view>
        <view class="h-cell"></view>
        <view class="h-cell"></view>
        <view class="h-cell"></view>
        <view class="h-cell"></view>
      </view>
    </view>
    <view class="header-text">
      <text class="page-title">接受挑战</text>
      <text class="page-sub">以标准的 5x5 方格为基础，数字从 1 到 25 按顺序挑战</text>
    </view>
  </view>

  <!-- ===== 闯关规则 ===== -->
  <view class="rules-card">
    <view class="rules-title-row">
      <view class="rules-icon"></view>
      <text class="rules-title">闯关规则</text>
    </view>

    <view class="rule-timeline">
      <view class="timeline-item">
        <view class="tl-dot">1</view>
        <view class="tl-line"></view>
        <view class="tl-content">
          <text class="tl-head">倒计时挑战</text>
          <text class="tl-desc">初始时间 1 分 30 秒，超时即失败</text>
        </view>
        <view class="tl-time-tag">90s</view>
      </view>

      <view class="timeline-item">
        <view class="tl-dot">2</view>
        <view class="tl-line"></view>
        <view class="tl-content">
          <text class="tl-head">逐关减时</text>
          <text class="tl-desc">每通过一关，下一关时间减少</text>
        </view>
      </view>

      <view class="timeline-item">
        <view class="tl-dot">3</view>
        <view class="tl-content">
          <text class="tl-head">试试你能挑战到第几关？</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 最佳纪录 ===== -->
  <view class="record-card" wx:if="{{bestRecord}}">
    <view class="record-header-row">
      <view class="record-icon"></view>
      <text class="record-title">最佳纪录</text>
    </view>
    <view class="record-body">
      <view class="record-item-left">
        <text class="record-label">闯关数</text>
        <text class="record-value">{{bestRecord.level}} 关</text>
      </view>
      <view class="record-divider"></view>
      <view class="record-item-right">
        <text class="record-label">最快用时</text>
        <text class="record-value brand">{{bestRecord.fastestTime}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 开始挑战按钮 ===== -->
  <view class="action-area">
    <view class="btn-row">
      <view class="btn-card" bindtap="onStartChallenge">
        <text class="btn-card-num">第 {{nextLevel}} 关</text>
        <text class="btn-card-action">开始挑战</text>
        <text class="btn-card-time">限时 {{nextLevelTime}}s</text>
      </view>
      <view class="btn-card btn-card-skip" bindtap="onSkipChallenge">
        <view class="ad-badge">
          <view class="ad-badge-play"></view>
          <text class="ad-badge-text">AD</text>
        </view>
        <text class="btn-card-num">直闯第 {{skipLevel}} 关</text>
        <text class="btn-card-action btn-card-action-skip">跳关挑战</text>
        <text class="btn-card-time">限时 {{skipLevelTime}}s</text>
      </view>
    </view>

    <view class="ad-wrap-pass">
      <ad-custom unit-id="adunit-2bb753c35ab3d982" bindload="adLoad" binderror="adError" bindclose="adClose"></ad-custom>
    </view>
  </view>
<time-up-modal visible="{{_timeUpModalVisible}}" />
</view>
