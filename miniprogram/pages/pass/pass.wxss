.page-container {
  min-height: 100vh;
  background: #FAF8F5;
  padding: 0 32rpx calc(50rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部标题 ===== */
.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 0 24rpx;
}

.header-icon {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  background: #07C160;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}

.header-grid {
  display: flex;
  flex-wrap: wrap;
  width: 44rpx;
  height: 44rpx;
  gap: 5rpx;
  justify-content: center;
  align-content: center;
}

.h-cell {
  width: 11rpx;
  height: 11rpx;
  background: #fff;
  border-radius: 2rpx;
  opacity: 0.95;
}

.header-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1E1B4B;
  line-height: 1.1;
  letter-spacing: -2rpx;
}

.page-sub {
  font-size: 24rpx;
  color: #8B8581;
  line-height: 1.5;
}

/* ===== 闯关规则卡片 ===== */
.rules-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}

.rules-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.rules-icon {
  width: 10rpx;
  height: 36rpx;
  background: #07C160;
  border-radius: 5rpx;
  flex-shrink: 0;
}

.rules-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E1B4B;
}

/* ===== 时间线规则 ===== */
.rule-timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding-bottom: 28rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.tl-dot {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ECFDF5;
  color: #07C160;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  position: relative;
}

.tl-line {
  position: absolute;
  left: 19rpx;
  top: 40rpx;
  bottom: 0;
  width: 2rpx;
  background: #EDE9E5;
}

.timeline-item:last-child .tl-line {
  display: none;
}

.tl-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-top: 6rpx;
}

.tl-head {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E1B4B;
  line-height: 1.3;
}

.tl-desc {
  font-size: 24rpx;
  color: #8B8581;
  line-height: 1.5;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tl-rules-inline {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.tl-rule-tag {
  font-size: 20rpx;
  color: #07C160;
  background: #ECFDF5;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.tl-time-tag {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #07C160;
  background: #ECFDF5;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  align-self: flex-start;
  margin-top: 4rpx;
}

/* ===== 最佳纪录卡片 ===== */
.record-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}

.record-header-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.record-icon {
  width: 10rpx;
  height: 36rpx;
  background: #F59E0B;
  border-radius: 5rpx;
  flex-shrink: 0;
}

.record-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E1B4B;
}

.record-body {
  display: flex;
  align-items: center;
  background: #FFFBEB;
  border: 2rpx solid #FDE68A;
  border-radius: 18rpx;
  padding: 24rpx 20rpx;
}

.record-item-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.record-item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.record-divider {
  width: 2rpx;
  height: 60rpx;
  background: #FDE68A;
  flex-shrink: 0;
}

.record-label {
  font-size: 22rpx;
  color: #A16207;
  font-weight: 500;
}

.record-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #92400E;
  letter-spacing: -1rpx;
}

.record-value.green {
  color: #07C160;
}

/* ===== 按钮区域 ===== */
.action-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding-top: 8rpx;
}

.btn-row {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

/* 主卡（第N关） */
.btn-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 32rpx 12rpx 26rpx;
  background: linear-gradient(145deg,#07C160,#059669);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(7,193,96,0.30), 0 2rpx 8rpx rgba(7,193,96,0.15);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
}
.btn-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 120rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
  pointer-events: none;
}
.btn-card:active {
  transform: scale(0.94);
  box-shadow: 0 4rpx 16rpx rgba(7,193,96,0.2);
}

.btn-card-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.10);
}

.btn-card-action {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.90);
  letter-spacing: 1rpx;
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.12);
}

.btn-card-time {
  font-size: 20rpx;
  color: rgba(255,255,255,0.65);
  font-weight: 500;
  margin-top: 2rpx;
}

/* 副卡（跳关） */
.btn-card-skip {
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06), 0 2rpx 8rpx rgba(0,0,0,0.03);
  border: 2rpx solid rgba(7,193,96,0.15);
}
.btn-card-skip::before {
  display: none;
}
.btn-card-skip:active {
  transform: scale(0.94);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.btn-card-skip .btn-card-num {
  color: #1E293B;
  font-weight: 800;
  text-shadow: none;
}

.btn-card-skip .btn-card-action {
  color: #07C160;
  background: rgba(7,193,96,0.08);
  font-weight: 700;
}

.btn-card-skip .btn-card-time {
  color: #94A3B8;
}
