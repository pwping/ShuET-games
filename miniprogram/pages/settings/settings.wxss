.page-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.settings-section {
  background: #fff;
  margin-top: 20rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.setting-info {
  flex: 1;
}

.setting-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.setting-desc {
  font-size: 24rpx;
  color: #999;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.setting-item-tap {
  transition: background 0.2s;
}
.setting-item-tap:active {
  background: #F8FAFC;
}

.setting-info-noicon {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.setting-title-inline {
  font-size: 30rpx;
  color: #333;
}

.age-tag-wrap {
  background: linear-gradient(135deg,rgba(7,193,96,0.06),rgba(7,193,96,0.10));
  border-radius: 24rpx;
  padding: 0;
  overflow: hidden;
  border: 1.5rpx solid rgba(7,193,96,0.12);
}

.setting-age-tag {
  display: block;
  font-size: 26rpx;
  color: #07C160;
  font-weight: 700;
  padding: 6rpx 22rpx;
  line-height: 1.4;
}

.setting-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.setting-divider {
  height: 2rpx;
  background: #f5f5f5;
  margin: 0 30rpx;
}

.version-info {
  text-align: center;
  padding: 60rpx 30rpx;
  font-size: 24rpx;
  color: #bbb;
}

.setting-item-logout {
  border-bottom: none;
}

.logout-title {
  color: #EF4444;
}

.logout-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  background: #fff;
  margin-top: 20rpx;
}

.logout-text {
  font-size: 30rpx;
  color: #333;
}
