<view class="page">
  <!-- ===== 用户信息区 ===== -->
  <view class="user-section">
    <button wx:if="{{!isLoggedIn}}" class="login-card privacy-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacy" bindtap="doLogin">
      <view class="avatar-ring">
        <view class="user-avatar-placeholder">
          <view class="grid-icon">
            <view class="grid-cell"></view>
            <view class="grid-cell"></view>
            <view class="grid-cell"></view>
            <view class="grid-cell"></view>
            <view class="grid-cell"></view>
            <view class="grid-cell"></view>
            <view class="grid-cell"></view>
            <view class="grid-cell"></view>
            <view class="grid-cell"></view>
          </view>
        </view>
      </view>
      <text class="user-name">点击授权登录</text>
      <text class="login-tip">登录后同步本地训练数据到云端</text>
    </button>
    <view wx:else class="login-card">
      <button class="avatar-choose-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-ring {{userInfo.avatarUrl ? '' : 'filled'}}">
          <view wx:if="{{userInfo.avatarUrl}}" class="user-avatar">
            <image src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          </view>
          <view wx:else class="user-avatar-placeholder logged">
            <view class="grid-icon">
              <view class="grid-cell"></view>
              <view class="grid-cell"></view>
              <view class="grid-cell"></view>
              <view class="grid-cell"></view>
              <view class="grid-cell"></view>
              <view class="grid-cell"></view>
              <view class="grid-cell"></view>
              <view class="grid-cell"></view>
              <view class="grid-cell"></view>
            </view>
          </view>
        </view>
      </button>
      <view class="nickname-wrap">
        <input class="nickname-input" type="nickname" value="{{userInfo.nickName || defaultNickName}}" bindinput="onNicknameChange" bindblur="onNicknameChange" placeholder="点击设置昵称" />
        <text class="nickname-tip" wx:if="{{!userInfo.nickName}}">点击可选取微信昵称</text>
      </view>
    </view>
  </view>

  <!-- ===== 滑动统计卡片 ===== -->
  <view class="stats-swiper-wrap">
    <swiper class="stats-swiper" vertical circular
      indicator-dots indicator-color="rgba(7,193,96,0.2)" indicator-active-color="#07C160"
      current="{{swiperCurrent}}" bindchange="onSwiperChange">
      <swiper-item>
        <view class="stats-card">
          <view class="sc-col">
            <text class="sc-val">{{stats.totalCount}}次</text>
            <text class="sc-label">舒尔特训练</text>
          </view>
          <view class="sc-divider"></view>
          <view class="sc-col" bindtap="onShowBestDetail">
            <text class="sc-val">{{stats.bestTime}}</text>
            <text class="sc-label">最佳成绩 ›</text>
          </view>
          <view class="sc-divider"></view>
          <view class="sc-col" bindtap="onGoPass">
            <text class="sc-val">{{stats.currentLevel}}</text>
            <text class="sc-label">挑战进度 ›</text>
          </view>
        </view>
      </swiper-item>
      <swiper-item>
        <view class="stats-card">
          <view class="sc-col">
            <text class="sc-val">{{hrStats.totalCount}}次</text>
            <text class="sc-label">华容道训练</text>
          </view>
          <view class="sc-divider"></view>
          <view class="sc-col">
            <text class="sc-val">{{hrStats.bestTime}}</text>
            <text class="sc-label">最佳用时</text>
          </view>
          <view class="sc-divider"></view>
          <view class="sc-col">
            <text class="sc-val">{{hrStats.minMoves}}</text>
            <text class="sc-label">最少步数</text>
          </view>
        </view>
      </swiper-item>
      <swiper-item>
        <view class="stats-card">
          <view class="sc-col">
            <text class="sc-val">{{mbStats.totalCount}}次</text>
            <text class="sc-label">积木迷阵训练</text>
          </view>
          <view class="sc-divider"></view>
          <view class="sc-col">
            <text class="sc-val">--</text>
            <text class="sc-label">—</text>
          </view>
          <view class="sc-divider"></view>
          <view class="sc-col" bindtap="onGoMovingBlock">
            <text class="sc-val">{{mbStats.challengeLevel}}</text>
            <text class="sc-label">挑战进度 ›</text>
          </view>
        </view>
      </swiper-item>
      <swiper-item>
        <view class="stats-card">
          <view class="sc-col">
            <text class="sc-val">{{sdStats.totalCount}}次</text>
            <text class="sc-label">数独训练</text>
          </view>
          <view class="sc-divider"></view>
          <view class="sc-col">
            <text class="sc-val">--</text>
            <text class="sc-label">—</text>
          </view>
          <view class="sc-divider"></view>
          <view class="sc-col">
            <text class="sc-val">{{sdStats.bestTime}}</text>
            <text class="sc-label">最佳用时</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <!-- 滑动提示：首次进入时显示 -->
    <view class="swipe-hint {{showSwipeHint ? 'hint-show' : ''}}">
      <view class="swipe-hint-icon">↕</view>
      <text class="swipe-hint-text">滑动切换</text>
    </view>
  </view>

  <!-- ===== 菜单列表 ===== -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goToHistory">
      <view class="menu-icon-wrap" style="background: linear-gradient(135deg, #DBEAFE, #BFDBFE);">
        <text class="menu-icon-text" style="color: #2563EB;">📋</text>
      </view>
      <text class="menu-text">训练记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item-wrap">
      <view class="menu-item">
        <view class="menu-icon-wrap" style="background: linear-gradient(135deg, #D1FAE5, #A7F3D0);">
          <view class="menu-icon-wechat"></view>
        </view>
        <text class="menu-text">分享</text>
        <text class="menu-arrow">›</text>
      </view>
      <button class="share-trigger" open-type="share"></button>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToSettings">
      <view class="menu-icon-wrap" style="background: linear-gradient(135deg, #F3E8FF, #E9D5FF);">
        <text class="menu-icon-text" style="color: #7C3AED;">⚙</text>
      </view>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 隐私授权确认按钮 -->
  <button id="privacy-btn" open-type="agreePrivacyAuthorization" style="display:none;"></button>

  <!-- 最佳成绩明细 - 底部弹窗 -->
  <view class="detail-overlay {{showBestDetail ? 'show' : ''}}" wx:if="{{showBestDetail}}" catchtap="onHideBestDetail"></view>
  <view class="detail-sheet {{showBestDetail ? 'sheet-active' : ''}} {{isDragging ? 'dragging' : ''}}"
        style="transform: translateY({{sheetTranslateY}}px)"
        catchtouchmove="onSheetTouchMove"
        catchtouchend="onSheetTouchEnd"
        catchtouchstart="onSheetTouchStart">
    <!-- 拖拽条 -->
    <view class="sheet-handle-area">
      <view class="sheet-handle"></view>
    </view>

    <!-- 标题 -->
    <view class="detail-title">
      <text class="detail-title-icon">🏆</text>
      <text>各模式最佳成绩</text>
    </view>

    <scroll-view class="detail-scroll" scroll-y show-scrollbar="{{false}}">
      <view class="detail-scroll-inner">
        <!-- 表头 -->
        <view class="detail-header">
          <text class="dh-col dh-mode">训练模式</text>
          <text class="dh-col dh-count">训练次数</text>
          <text class="dh-col dh-time">最短时间</text>
        </view>

        <!-- 数据行 -->
        <view class="detail-row" wx:for="{{bestDetailData}}" wx:key="modeLabel" wx:for-item="item">
          <text class="dr-col dr-mode">{{item.modeLabel}}</text>
          <text class="dr-col dr-count">{{item.count}}</text>
          <text class="dr-col dr-time">{{item.bestTimeLabel}}</text>
        </view>

        <!-- 空状态 -->
        <view class="detail-empty" wx:if="{{bestDetailData.length === 0}}">
          <text>暂无训练记录</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <custom-tabbar active="mine"></custom-tabbar>

  <!-- 隐私授权弹窗 -->
  <privacy-auth id="privacyAuth" bind:agree="onPrivacyAgreed" bind:reject="onPrivacyRejected"></privacy-auth>

  <!-- 头像设置引导 -->
  <avatar-guide visible="{{showAvatarGuide}}" bind:done="onAvatarGuideDone"></avatar-guide>
</view>
