<view class="page">
  <!-- 顶部信息（固定不动） -->
  <view class="fixed-header">
    <view class="mode-title-wrap">
      <view class="mode-title-badge">
        <view class="badge-dot"></view>
        选择关卡
      </view>
    </view>
    <view class="progress-card">
      <view class="pc-title-row" bindtap="onStartTap" hover-class="btn-hover">
        <text class="pc-main-title">{{completedCount > 0 ? '第' + completedCount + '关' : '未开始'}}</text>
        <text class="pc-badge" wx:if="{{completedCount > 0}}">已通关</text>
      </view>
      <view class="pc-sub-row">
        <text class="pc-sub-text">已通关 {{completedCount}} / {{totalLevels}} 关</text>
      </view>
      <view class="pc-progress-bar">
        <view class="pc-progress-fill" style="width:{{progressPercent}}%"></view>
      </view>
    </view>
  </view>

  <!-- 关卡列表（可滚动） -->
  <scroll-view class="level-scroll" scroll-y enable-back-to-top>
    <view class="section-header">选择关卡 (1-{{totalLevels}})</view>
    <view class="level-grid">
      <view wx:for="{{displayLevels}}" wx:key="id"
        class="level-card {{item.completed ? 'completed' : ''}} {{item.isNext ? 'next' : ''}} {{item.showLock ? 'locked' : ''}}"
        data-index="{{index}}" catchtap="onLevelTap">
        <view class="level-inner">
          <text class="level-num">第{{item.id}}关</text>
          <view class="level-badge">
            <text wx:if="{{item.completed}}" class="check-icon">✓</text>
            <view wx:elif="{{item.showLock}}" class="lock-row">
              <text class="lock-icon">🔒</text>
              <text class="steps-text" wx:if="{{item.steps}}">{{item.steps}}步</text>
            </view>
            <text wx:elif="{{item.steps}}" class="steps-text">{{item.steps}}步</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{canLoadMore}}" class="load-more" catchtap="onLoadMore">
      <view class="load-more-line"></view>
      <view class="load-more-text">展开更多关卡</view>
      <view class="load-more-line"></view>
    </view>
    <view wx:else class="load-done">
      <view class="load-done-line"></view>
      <text class="load-done-text">全部关卡已加载完毕</text>
      <view class="load-done-line"></view>
    </view>

    <!-- ===== 贴片广告 ===== -->
    <view class="ad-wrap">
      <ad-custom unit-id="adunit-2bb753c35ab3d982"></ad-custom>
    </view>
  </scroll-view>

  <!-- ===== 跳关弹窗 ===== -->
  <view class="skip-overlay {{showSkipModal ? 'active' : ''}}" catchtouchmove="preventMove">
    <view class="skip-dialog">
      <view class="skip-close" bindtap="onSkipModalClose">✕</view>
      <view class="skip-header">
        <view class="skip-icon-wrap">🚀</view>
        <text class="skip-title">跳关解锁</text>
      </view>
      <view class="skip-body">
        <view class="skip-desc">
          <text class="skip-desc-line">关卡需按顺序挑战</text>
          <text class="skip-desc-line">通过上一关才能解锁下一关</text>
          <text class="skip-desc-line">如想直接挑战本关</text>
          <text class="skip-desc-line">需观看广告解锁激活</text>
        </view>
      </view>
      <view class="skip-actions">
        <view class="skip-btn skip-btn-order" bindtap="onPlayOrder" hover-class="skip-btn-hover">
          <view class="skip-btn-icon skip-order-icon"></view>
          <text class="skip-btn-lbl">按顺序闯关</text>
        </view>
        <view class="skip-btn skip-btn-ad" bindtap="onSkipAdTap" hover-class="skip-btn-hover">
          <view class="skip-btn-icon skip-ad-icon"></view>
          <text class="skip-btn-lbl">观看广告</text>
        </view>
      </view>
    </view>
  </view>
<time-up-modal visible="{{_timeUpModalVisible}}" />
</view>
