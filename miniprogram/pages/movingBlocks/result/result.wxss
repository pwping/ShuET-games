.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  background: #FFFBF0;
}

/* ===== 装饰背景圆 ===== */
.deco-circle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.deco-big {
  top: -120rpx;
  right: -80rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(250,204,21,0.1) 0%, transparent 70%);
}
.deco-small {
  bottom: 200rpx;
  left: -180rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(253,224,106,0.08) 0%, transparent 70%);
}

/* ===== 主内容区 ===== */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 36rpx 20rpx;
}

/* ===== 图标区 ===== */
.icon-section {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.icon-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(250,204,21,0.1);
  animation: icon-breathe 3s ease-in-out infinite;
}
@keyframes icon-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}
.icon-emoji {
  font-size: 72rpx;
  z-index: 1;
}
.icon-ring {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #FCD34D;
  opacity: 0.3;
  animation: ring-pulse 2s ease-in-out infinite;
}
@keyframes ring-pulse {
  0%, 100% { transform: scale(1); opacity: 0.3; }
  50% { transform: scale(1.12); opacity: 0.1; }
}

/* ===== 标题 ===== */
.result-level {
  font-size: 28rpx;
  color: #A16207;
  font-weight: 600;
  padding: 8rpx 28rpx;
  background: rgba(250,204,21,0.1);
  border-radius: 30rpx;
  border: 2rpx solid rgba(250,204,21,0.15);
  margin-bottom: 16rpx;
}

/* ===== 星级 ===== */
.stars-row {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.title-stars {
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.title-stars .star {
  font-size: 32rpx;
}
.star {
  font-size: 48rpx;
  color: #E2E8F0;
  transition: all 0.3s ease;
}
.star.active {
  color: #F59E0B;
  text-shadow: 0 2rpx 8rpx rgba(245,158,11,0.3);
}

/* 评价语录 */
.result-quote {
  font-size: 26rpx;
  color: #A16207;
  text-align: center;
  line-height: 1.5;
  padding: 12rpx 24rpx;
  background: rgba(250,204,21,0.08);
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  font-weight: 500;
}

/* ===== 统计卡片 ===== */
.stats-row {
  display: flex;
  gap: 24rpx;
  width: 100%;
  margin-bottom: 28rpx;
}
.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.06), 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.stat-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(250,204,21,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}
.stat-icon {
  font-size: 28rpx;
}
.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #B45309;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 22rpx;
  color: #A16207;
  font-weight: 500;
}
.stat-card-lines {
  flex-direction: column;
  align-items: center;
  padding: 24rpx 20rpx;
}
.stat-lines-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.stat-line-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 16rpx;
  flex-wrap: nowrap;
}
.stat-lbl {
  font-size: 24rpx;
  color: #A16207;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}
.stat-num {
  font-size: 30rpx;
  font-weight: 800;
  color: #B45309;
  white-space: nowrap;
  flex-shrink: 0;
}
.stat-divider {
  height: 2rpx;
  background: #FEF3C7;
  margin: 0 16rpx;
  border-radius: 1rpx;
}


/* ===== 记录入口 ===== */
.records-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  padding: 20rpx 0;
  margin-bottom: 8rpx;
  cursor: pointer;
}
.records-entry-text {
  font-size: 24rpx;
  color: #A16207;
  font-weight: 500;
}
.records-entry-arrow {
  font-size: 24rpx;
  color: #D4A574;
  transition: transform 0.15s;
}
.entry-hover .records-entry-arrow {
  transform: translateX(6rpx);
}

/* ===== 底部按钮 ===== */
.bottom-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
  width: 100%;
}
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: 1;
  padding: 26rpx 0;
  background: linear-gradient(135deg,#FCD34D,#F59E0B);
  color: #FFF;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 28rpx rgba(245,158,11,0.3);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.btn-primary.btn-hover {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(245,158,11,0.2);
}
.btn-secondary {
  text-align: center;
  padding: 26rpx 0;
  flex: 1;
  background: #fff;
  color: #B45309;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid rgba(250,204,21,0.35);
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-secondary.btn-hover-light {
  background: rgba(250,204,21,0.04);
  transform: scale(0.97);
}
.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1;
  padding: 26rpx 0;
  margin: 0;
  background: #fff;
  color: #B45309;
  border-radius: 48rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid rgba(250,204,21,0.35);
  transition: transform 0.15s ease, background 0.15s ease;
  line-height: 1.4;
  overflow: visible;
  outline: none;
}
.btn-share::after {
  display: none;
  border: none;
}
.share-hover {
  background: rgba(250,204,21,0.04);
  transform: scale(0.96);
}
.share-text {
  line-height: 1;
}
