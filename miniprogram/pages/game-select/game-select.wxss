.page-container {
  min-height: 100vh;
  background: #FFFFFF;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  padding: 60rpx 32rpx 0;
  overflow: hidden;
  margin-bottom: 48rpx;
}
.hero-bg {
  position: absolute;
  top: -60rpx; left: -100rpx; right: -100rpx;
  height: 420rpx;
  background: linear-gradient(180deg,#F0FDF4 0%,#F8FAFC 100%);
  border-radius: 0 0 60rpx 60rpx;
  z-index: 0;
}
.hero-content { position: relative; z-index: 1; }
.hero-badge {
  display: inline-flex; align-items: center; gap: 10rpx;
  font-size: 22rpx; font-weight: 600; color: #07C160;
  background: rgba(7,193,96,0.08); padding: 8rpx 24rpx;
  border-radius: 24rpx; margin-bottom: 20rpx;
  border: 2rpx solid rgba(7,193,96,0.12);
}
.badge-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #07C160;
  animation: pulse-dot 2s ease-in-out infinite;
}
@keyframes pulse-dot {
  0%,100%{opacity:1;transform:scale(1)}
  50%{opacity:.5;transform:scale(.8)}
}
.hero-title {
  display: block;
  font-size: 52rpx; font-weight: 800; color: #07C160;
  letter-spacing: -2rpx; margin-bottom: 12rpx;
}
.hero-desc {
  font-size: 26rpx; color: #64748B;
}

/* ===== 游戏卡片 ===== */
.game-section {
  padding: 0 32rpx 60rpx;
}
.section-header {
  display: flex; align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx; padding: 0 4rpx;
}
.section-title {
  font-size: 32rpx; font-weight: 800; color: #1E293B;
  letter-spacing: -1rpx;
}
.section-sub {
  font-size: 22rpx; color: #94A3B8;
}


.game-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}
.game-card {
  border-radius: 28rpx; padding: 40rpx 24rpx 32rpx;
  min-height: 280rpx;
  display: flex; align-items: center; justify-content: center;
  background: #fff;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.06), 0 1rpx 4rpx rgba(0,0,0,0.04);
  border: 2rpx solid rgba(0,0,0,0.04);
  transition: transform .15s ease, box-shadow .15s ease;
  position: relative;
  overflow: visible;
}
.new-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: linear-gradient(135deg, #F97316, #EF4444);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 22rpx;
  padding: 0 14rpx;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(239,68,68,0.4);
}
.game-card:active {
  transform: scale(.96) translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.game-card-inner {
  display: flex; flex-direction: column;
  align-items: center; text-align: center;
}

/* 图标 */
.game-icon-wrap {
  position: relative; margin-bottom: 24rpx;
}
.game-icon-wrap::before {
  content: ''; position: absolute;
  top:-4rpx; left:-4rpx; right:-4rpx; bottom:-4rpx;
  background: inherit; border-radius: 24rpx;
  opacity: .18; filter: blur(16rpx); z-index: 0;
}
.game-icon {
  position: relative; z-index: 1;
  width: 100rpx; height: 100rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 -2rpx 4rpx rgba(0,0,0,0.08);
}

/* 舒尔特3x3图标 */
.grid-3x3 {
  display: grid;
  grid-template-columns: repeat(3, 18rpx);
  gap: 4rpx;
}
.gc {
  width: 18rpx; height: 18rpx;
  background: #fff; border-radius: 3rpx;
}
.gc-num {
  font-size: 18rpx; font-weight: 700;
  color: #3B82F6;
  display: flex; align-items: center; justify-content: center;
  line-height: 18rpx;
}

/* 华容道图标 */
.klotski-icon {
  display: flex; flex-direction: column; gap: 3rpx;
}
.ki-row { display: flex; gap: 3rpx; }
.ki-tile {
  width: 22rpx; height: 22rpx;
  background: rgba(255,255,255,0.9); border-radius: 4rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 14rpx; font-weight: 700; color: #E91E63;
}
.ki-empty { background: transparent; }

/* 数独图标（匹配华容道方块样式） */
.sd-icon-grid {
  display: grid;
  grid-template-columns: repeat(3, 22rpx);
  gap: 3rpx;
}
.sd-icon-tile {
  width: 22rpx; height: 22rpx;
  background: rgba(255,255,255,0.9); border-radius: 4rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 14rpx; font-weight: 700; color: #3B82F6;
}
.sd-icon-empty { background: rgba(255,255,255,0.9); }

/* 积木迷阵图标 */
.moveblock-icon {
  width: 100rpx; height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mb-grid {
  display: grid;
  grid-template-columns: repeat(4, 16rpx);
  grid-template-rows: repeat(4, 16rpx);
  gap: 3rpx;
  position: relative;
}
.mb-cell {
  background: rgba(255,255,255,0.15);
  border-radius: 3rpx;
}
.mb-block {
  background: rgba(255,255,255,0.9);
  border-radius: 4rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}
.mb-block-h { background: rgba(255,255,255,0.9); }
.mb-block-v { background: rgba(255,255,255,0.85); }
.mb-gap {
  background: rgba(255,255,255,0.08);
  border: 2rpx dashed rgba(255,255,255,0.3);
  border-radius: 3rpx;
}
.mb-arrow {
  position: absolute;
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 14rpx;
  color: rgba(255,255,255,0.6);
}

.game-name {
  font-size: 30rpx; font-weight: 700; color: #1E293B;
  margin-bottom: 8rpx;
}
.game-desc {
  font-size: 22rpx; color: #64748B; line-height: 1.4;
}
.coming-soon-icon {
  font-size: 42rpx;
  color: #fff;
}
.baishu-icon {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bs-circle {
  position: absolute;
  width: 100%;
  height: 100%;
}
.bs-num {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  font-size: 14rpx;
  font-weight: 700;
  color: #fff;
  background: #FF8C00;
  border-radius: 50%;
  text-align: center;
  line-height: 24rpx;
  margin-left: -12rpx;
  margin-top: -12rpx;
  transform-origin: center center;
}
.bs-num:nth-child(1) { transform: rotate(270deg) translateY(-36rpx) rotate(-270deg); }
.bs-num:nth-child(2) { transform: rotate(306deg) translateY(-36rpx) rotate(-306deg); }
.bs-num:nth-child(3) { transform: rotate(342deg) translateY(-36rpx) rotate(-342deg); }
.bs-num:nth-child(4) { transform: rotate(18deg)  translateY(-36rpx) rotate(-18deg); }
.bs-num:nth-child(5) { transform: rotate(54deg)  translateY(-36rpx) rotate(-54deg); }
.bs-num:nth-child(6) { transform: rotate(90deg)  translateY(-36rpx) rotate(-90deg); }
.bs-num:nth-child(7) { transform: rotate(126deg) translateY(-36rpx) rotate(-126deg); }
.bs-num:nth-child(8) { transform: rotate(162deg) translateY(-36rpx) rotate(-162deg); }
.bs-num:nth-child(9) { transform: rotate(198deg) translateY(-36rpx) rotate(-198deg); }
.bs-num:nth-child(10) { transform: rotate(234deg) translateY(-36rpx) rotate(-234deg); }
.bs-center {
  position: relative;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  background: #88D8A0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(136,216,160,0.5);
}
.bs-triangle {
  width: 0;
  height: 0;
  border-left: 10rpx solid #fff;
  border-top: 7rpx solid transparent;
  border-bottom: 7rpx solid transparent;
  margin-left: 3rpx;
}
.coming-badge {
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  background: #F1F5F9;
  color: #94A3B8;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.sd-empty {
  background: transparent;
}

/* ===== 贴图广告 ===== */
.ad-wrap-home {
  margin-top: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}