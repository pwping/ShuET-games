{
  "pages": [
    "pages/game-select/game-select",
    "pages/index/index",
    "pages/level/level",
    "pages/game/game",
    "pages/result/result",
    "pages/mine/mine",
    "pages/pass/pass",
    "pages/challenge/challenge",
    "pages/intro/intro",
    "pages/history/history",
    "pages/settings/settings"
  ],
  "subPackages": [
    {
      "root": "pages/huarongDao/",
      "pages": [
        "mode/mode",
        "level/level",
        "game/game",
        "result/result"
      ]
    },
    {
      "root": "pages/movingBlocks/",
      "pages": [
        "level/level",
        "game/game",
        "result/result"
      ]
    },
    {
      "root": "pages/sudoku/",
      "pages": [
        "level/level",
        "game/game",
        "result/result"
      ]
    }
  ],
  "preloadRule": {
    "pages/game-select/game-select": {
      "network": "all",
      "packages": ["pages/huarongDao/", "pages/movingBlocks/", "pages/sudoku/"]
    }
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTitleText": "智趣训练",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f5f5f5"
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "__usePrivacyCheck__": true,
  "enablePassiveEvent": {
    "default": true
  }
}
